{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "jest",
    "test:cache": "jest src/tests/sentimentCache.test.ts",
    "lint": "eslint .",
    "cache:clear": "node -e \"import('./dist/services/sentimentCache.service.js').then(m => m.sentimentCache.clearCache().then(console.log))\"",
    "cache:stats": "node -e \"import('./dist/services/sentimentCache.service.js').then(m => m.sentimentCache.getStats().then(console.log))\""
  },
  "dependencies": {
    "@types/ioredis": "^5.0.0",
    "@xenova/transformers": "^2.17.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
