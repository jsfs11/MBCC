# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Redis Configuration for Sentiment Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SENTIMENT_CACHE_TTL=604800

# Optional: Redis Cluster Configuration (for production)
# REDIS_CLUSTER_NODES=host1:port1,host2:port2,host3:port3

# Optional: Redis SSL Configuration
# REDIS_SSL=true
# REDIS_CERT_PATH=/path/to/cert.pem